# Server
PORT=5000
# Local MongoDB: mongodb://127.0.0.1:27017/wyndells
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wyndells
MONGODB_URI=mongodb://127.0.0.1:27017/wyndells

# Allowed origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Default credentials created by `npm run seed --workspace server`
ADMIN_EMAIL=admin@wyndells.com
ADMIN_PASSWORD=Admin123!
MANAGER_PASSWORD=Manager123!