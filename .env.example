# Server
PORT=5000

# Supabase (https://supabase.com)
# Project URL + service-role key, found under Project Settings → API.
# The service-role key bypasses Row Level Security, so authorization stays in
# the Express API. Never expose it to the browser or the client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Allowed origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign auth tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Default credentials created by `npm run seed --workspace server`
ADMIN_EMAIL=admin@wyndells.com
ADMIN_PASSWORD=Admin123!
MANAGER_PASSWORD=Manager123!